# Оркестрация docker-compose (суперпроект). Скопировать в .env (в git не коммитится).
# Параметры сервисов стенда. Секреты реальных окружений — не сюда.

# Postgres
POSTGRES_USER=praxis
POSTGRES_PASSWORD=praxis
POSTGRES_DB=praxis
POSTGRES_PORT=5432

# API (learningBack)
API_PORT=8000
APP_ENV=development

# pgAdmin (веб-UI к Postgres стенда; dev-инструмент)
PGADMIN_EMAIL=admin@praxis.dev
PGADMIN_PASSWORD=praxis
PGADMIN_PORT=5050

# LLM. Пусто → детерминированные заглушки, приложение работает без ключей.
# Приоритет: OpenAI-совместимый провайдер → Claude → Mock.
#
# Провайдер задаётся адресом, а не кодом: любой сервис с /chat/completions и
# tool calling подходит. Проверено на RouterAI и OpenRouter.
LLM_API_KEY=
LLM_BASE_URL=https://routerai.ru/api/v1
LLM_MODEL_GENERATION=deepseek/deepseek-v4-flash-0731
LLM_MODEL_SCORING=deepseek/deepseek-v4-flash-0731

# Альтернатива: OpenRouter
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL_GENERATION=google/gemini-3.7-flash

CLAUDE_API_KEY=
