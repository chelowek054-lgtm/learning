# ЕДИНСТВЕННЫЙ файл окружения проекта. Скопировать в `.env` (в git не коммитится).
#
# Отсюда конфигурируется всё:
#   * docker-compose        — читает `.env` в этой папке сам;
#   * learningBack          — `core/config.py` читает ЭТОТ же файл (не свой);
#   * learningFront (Expo)  — `npm start`/`web` переносит сюда EXPO_PUBLIC_*
#                             в свой `.env` (он генерируется, править его незачем).
#
# Отдельных `.env` в сабмодулях быть не должно: раньше их было три, и они
# расходились молча. Секреты продовых окружений — не сюда.

# --- Postgres -----------------------------------------------------------
# Из этих значений собирается DATABASE_URL — отдельно его задавать не нужно.
# POSTGRES_PORT — порт, опубликованный НА ХОСТ (внутри compose всегда 5432).
POSTGRES_USER=praxis
POSTGRES_PASSWORD=praxis
POSTGRES_DB=praxis
POSTGRES_PORT=5432

# --- API (learningBack) -------------------------------------------------
API_PORT=8000
APP_ENV=development
# CORS для web-клиента: "*" или список origin через запятую.
CORS_ORIGINS=*

# --- pgAdmin (dev-инструмент) -------------------------------------------
PGADMIN_EMAIL=admin@praxis.dev
PGADMIN_PASSWORD=praxis
PGADMIN_PORT=5050

# --- LLM ----------------------------------------------------------------
# Пусто → детерминированные заглушки, приложение работает без ключа.
# Провайдер задаётся адресом, а не кодом: подойдёт любой сервис с
# /chat/completions и tool calling. Чтобы сменить — поменять LLM_BASE_URL,
# LLM_API_KEY и слаги моделей; править код не нужно.
# Ключ читает ТОЛЬКО backend (инвариант №2).
LLM_API_KEY=
LLM_BASE_URL=https://routerai.ru/api/v1
LLM_MODEL_GENERATION=deepseek/deepseek-v4-flash-0731
LLM_MODEL_SCORING=deepseek/deepseek-v4-flash-0731

# --- Клиент (learningFront) ---------------------------------------------
# EXPO_PUBLIC_* попадают в бандл клиента — СЕКРЕТЫ СЮДА НЕ КЛАСТЬ (инвариант №2).
# Для запуска на телефоне нужен адрес машины в сети, а не localhost:
# сверять через ipconfig при смене сети, иначе клиент молча не достучится.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000
